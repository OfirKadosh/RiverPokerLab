{
  "name": "river-poker-lab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run typecheck:core && npm --prefix frontend run build",
    "benchmark:river": "npm --prefix backend run benchmark:river --",
    "start": "npm --prefix backend start",
    "test": "npm --prefix packages/core test && npm --prefix backend test && npm --prefix frontend test",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "admin:create": "npm --prefix backend run admin:create --",
    "preview:dev": "npm --prefix frontend run preview:dev",
    "test:core": "npm --prefix packages/core test",
    "typecheck:core": "node frontend/node_modules/typescript/bin/tsc -p packages/core/tsconfig.native.json",
    "setup": "node scripts/setup.cjs",
    "release:check": "npm test && npm run build"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
