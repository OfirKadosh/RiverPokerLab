# Template only. Enter actual secrets in the hosting dashboard, never in Git.
NODE_ENV=production
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/YOUR_DATABASE
AUTH_SECRET=
SERVE_FRONTEND=true
TRUST_PROXY_HOPS=1
AUTH_ALLOW_DEV_DELIVERY=false
AUTH_ALLOW_MANUAL_DELIVERY=true
EMAIL_PROVIDER=manual
SMS_PROVIDER=disabled
# On Render, leave APP_ORIGINS unset: RENDER_EXTERNAL_URL supplies the exact origin.
# On another host or with a custom domain, set the actual HTTPS origin(s):
# APP_ORIGINS=https://YOUR_HOST
