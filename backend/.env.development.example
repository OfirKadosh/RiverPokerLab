# Copy to .env.development; use an Atlas user restricted to the dev database.
# npm run dev forces the database name river_poker_lab_dev, even if the URI names another DB.
MONGO_URI=mongodb+srv://YOUR_DEV_USER:YOUR_DEV_PASSWORD@YOUR_CLUSTER/river_poker_lab_dev
AUTH_SECRET=
PORT=5000
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_ALLOW_DEV_DELIVERY=true
AUTH_ALLOW_MANUAL_DELIVERY=false
EMAIL_PROVIDER=development
SMS_PROVIDER=development
SERVE_FRONTEND=false
TRUST_PROXY_HOPS=0
