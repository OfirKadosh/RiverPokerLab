MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/YOUR_DATABASE
PORT=5000
NODE_ENV=development

# Required. Generate a fresh random secret locally; never commit it.
AUTH_SECRET=
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HOPS=0

# Explicit local development mode: codes are printed ONLY in the backend terminal.
# These settings must not be used for a public/production server.
AUTH_ALLOW_DEV_DELIVERY=true
EMAIL_PROVIDER=development
SMS_PROVIDER=development

# Real email delivery: EMAIL_PROVIDER=resend, AUTH_ALLOW_DEV_DELIVERY=false
RESEND_API_KEY=
EMAIL_FROM=

# Real SMS delivery: SMS_PROVIDER=twilio, AUTH_ALLOW_DEV_DELIVERY=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Set an unused channel's provider to disabled.

# Hosted manual activation is separate from local development delivery.
# EMAIL_PROVIDER=manual requires this explicit flag; no email/SMS is sent.
AUTH_ALLOW_MANUAL_DELIVERY=false
# To serve the built React app from this server: SERVE_FRONTEND=true
SERVE_FRONTEND=false
# Render supplies RENDER_EXTERNAL_URL; APP_ORIGINS can override it explicitly.
